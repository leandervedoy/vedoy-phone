# Vedoy Phone server configuration
# Copy to server/.env locally. In Vercel, create the same values under the API project's Environment Variables.
# Never place these secrets in mobile/ or public/.

NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=https://your-phone-api.example.com
APP_ORIGINS=vedoyphone://,https://vedoy-phone.vercel.app

# Neon: use the pooled connection string from the Phone API's Neon branch.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-NEON-AUTH-HOST/auth
AWS_REGION=eu-central-1
AWS_ENDPOINT_URL_S3=https://YOUR-NEON-STORAGE-ENDPOINT
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KYC_BUCKET=uploads
ADMIN_EMAILS=admin@example.com

# Twilio is the active provider in this codebase.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CALLER_ID=+4700000000
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_IOS_PUSH_CREDENTIAL_SID=CRxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ANDROID_PUSH_CREDENTIAL_SID=CRxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telnyx: store these only when the Telnyx adapter is added and enabled.
# The current API routes remain wired to Twilio; do not switch providers until that adapter is deployed.
TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_CONNECTION_ID=
TELNYX_CALLER_ID=+4700000000

VOICE_ALLOWED_COUNTRIES=NO,SE,DK,FI,GB,US
SMS_ALLOWED_COUNTRIES=NO,SE,DK,FI,GB,US
MAX_NUMBERS_PER_USER=5
MAX_SMS_PER_MINUTE=20
MAX_NUMBER_SEARCH_RESULTS=30
