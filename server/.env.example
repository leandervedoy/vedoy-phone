NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=https://api.example.com
APP_ORIGINS=vedoyphone://,https://vedoy-phone.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://your-neon-auth-url/neondb/auth
NEON_STORAGE_ENDPOINT=https://your-neon-storage-endpoint
NEON_STORAGE_REGION=eu-central-1
NEON_STORAGE_BUCKET=uploads
NEON_STORAGE_ACCESS_KEY_ID=server-only-storage-access-key
NEON_STORAGE_SECRET_ACCESS_KEY=server-only-storage-secret-key
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_API_KEY=SK00000000000000000000000000000000
TWILIO_API_SECRET=server-only-api-secret
TWILIO_AUTH_TOKEN=server-only-auth-token
TWILIO_TWIML_APP_SID=AP00000000000000000000000000000000
TWILIO_CALLER_ID=+4700000000
TWILIO_MESSAGING_SERVICE_SID=MG00000000000000000000000000000000
TWILIO_IOS_PUSH_CREDENTIAL_SID=CR00000000000000000000000000000000
TWILIO_ANDROID_PUSH_CREDENTIAL_SID=CR00000000000000000000000000000000
MAX_NUMBERS_PER_USER=5
MAX_SMS_PER_MINUTE=20
MAX_NUMBER_SEARCH_RESULTS=30
VOICE_ALLOWED_COUNTRIES=NO,SE,DK,FI,GB,US
SMS_ALLOWED_COUNTRIES=NO,SE,DK,FI,GB,US
